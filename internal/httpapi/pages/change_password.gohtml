{{define "change_password"}}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <link rel="icon" data-theme-logo type="image/svg+xml" href="{{$.Asset "images/webssh-logo.svg"}}">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="app-root" content="{{$.URLPrefix}}">
    <title data-i18n="auth.changePasswordPageTitle">Change password · WebSSH</title>
    <link rel="stylesheet" href="{{$.Asset "vendor/material-icons/material-icons.css"}}">
    <link rel="stylesheet" href="{{$.Asset "css/style.css"}}">
    <link rel="stylesheet" href="{{$.Asset "css/auth.css"}}">
    <link rel="stylesheet" href="{{$.Asset "css/webssh-2.css"}}">
    <link rel="stylesheet" href="{{$.Asset "css/product-ui.css"}}">
    <link rel="stylesheet" href="{{$.Asset "css/midnight-ui.css"}}">
    <link rel="stylesheet" href="{{$.Asset "css/branding.css"}}">
    <link rel="stylesheet" href="{{$.Asset "css/theme-scenes.css"}}">
    <script src="{{$.Asset "js/branding.js"}}" defer></script>
</head>
<body class="webssh-ui webssh-auth" data-theme="{{$.Theme}}" data-defer-theme-background>
    <script src="{{$.Asset "js/theme-preference.js"}}"></script>

    <div class="auth-shell">
        <header class="auth-utility-bar">
            <div class="auth-instance-state">
                <span class="material-icons" aria-hidden="true">dns</span>
                <span data-i18n="auth.instanceStatus">WebSSH instance</span>
                <strong id="authInstanceAddress"></strong>
            </div>
            <a class="auth-shell-return" href="{{$.URL "/"}}">
                <span class="material-icons" aria-hidden="true">arrow_back</span>
                <span data-i18n="auth.backToApp">Back to App</span>
            </a>
        </header>

        <main class="auth-shell-content">
            <section class="auth-access-dock">
                <div class="auth-context-panel">
                    <div class="auth-brand-lockup">
                        <a class="auth-product-brand" href="{{$.URL "/"}}" aria-label="WebSSH workspace" data-i18n-aria-label="navigation.websshWorkspaces">
                            {{template "brand_logo" ($.Logo "auth-product-logo" false)}}
                        </a>
                        <p class="auth-context-footer" data-i18n="brand.tagline">Your shell. Your rules.</p>
                    </div>
                    <div class="auth-context-copy">
                        <span class="auth-brand-eyebrow" data-i18n="auth.localCredentials">Local credentials</span>
                        <h1 data-i18n="auth.passwordOverviewTitle">This password belongs only to your local WebSSH account.</h1>
                        <p data-i18n="auth.passwordOverviewHint">If you sign in through LDAP or OIDC, change that password with your identity provider instead of on this page.</p>
                        <ul class="auth-path-list" aria-label="Local credential" data-i18n-aria-label="auth.localCredentials">
                            <li data-auth-path="local">
                                <span class="material-icons" aria-hidden="true">password</span>
                                <span><strong data-i18n="auth.localCredentials">Local credentials</strong><small data-i18n="auth.localAccessHint">WebSSH username and password</small></span>
                            </li>
                        </ul>
                    </div>
                </div>
                <div class="auth-form-panel">
                <div class="auth-container">
                    <div class="auth-card">
            <div class="auth-header">
                <span class="auth-form-eyebrow" data-i18n="auth.localCredentials">Local credentials</span>
                <h1 data-i18n="auth.changePassword">Change Password</h1>
                <p data-i18n="auth.passwordOverviewHint">If you sign in through LDAP or OIDC, change that password with your identity provider instead of on this page.</p>
            </div>

            
            {{template "auth_messages" $}}

            <div class="auth-credentials-zone">
            <form method="POST" action="{{$.URL "/change-password"}}" id="changePasswordForm">
                <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}"/>
                <div class="form-group">
                    <label for="current_password" data-i18n="auth.currentPassword">Current Password</label>
                    <div class="input-wrapper">
                        <span class="input-icon material-icons" aria-hidden="true">lock</span>
                        <input type="password" id="current_password" aria-describedby="currentPasswordHint" name="current_password"
                               class="form-control" data-i18n-placeholder="auth.currentPassword"
                               placeholder="Current Password" required autofocus>
                        <button type="button" class="password-toggle material-icons" data-target="current_password" aria-label="Toggle password visibility" data-i18n-aria-label="auth.togglePasswordVisibility">visibility</button>
                    </div>
                    <div class="field-hint" id="currentPasswordHint"></div>
                </div>

                <div class="form-group">
                    <label for="new_password" data-i18n="auth.newPassword">New Password</label>
                    <div class="input-wrapper">
                        <span class="input-icon material-icons" aria-hidden="true">vpn_key</span>
                        <input type="password" id="new_password" aria-describedby="newPasswordHint" name="new_password"
                               class="form-control" data-i18n-placeholder="auth.newPassword"
                               placeholder="New Password" required minlength="8">
                        <button type="button" class="password-toggle material-icons" data-target="new_password" aria-label="Toggle password visibility" data-i18n-aria-label="auth.togglePasswordVisibility">visibility</button>
                    </div>
                    <div class="field-hint" id="newPasswordHint" data-i18n="auth.passwordHint">Minimum 8 characters</div>
                </div>

                <div class="form-group">
                    <label for="confirm_password" data-i18n="auth.confirmNewPassword">Confirm New Password</label>
                    <div class="input-wrapper">
                        <span class="input-icon material-icons" aria-hidden="true">vpn_key</span>
                        <input type="password" id="confirm_password" aria-describedby="confirmPasswordHint" name="confirm_password"
                               class="form-control" data-i18n-placeholder="auth.confirmNewPassword"
                               placeholder="Confirm New Password" required>
                        <button type="button" class="password-toggle material-icons" data-target="confirm_password" aria-label="Toggle password visibility" data-i18n-aria-label="auth.togglePasswordVisibility">visibility</button>
                    </div>
                    <div class="field-hint" id="confirmPasswordHint"></div>
                </div>

                <button type="submit" class="btn-primary">
                    <span data-i18n="auth.updatePassword">Update Password</span>
                </button>
            </form>
            </div>

            <div class="auth-footer">
                <a href="{{$.URL "/"}}" data-i18n="auth.backToApp">Back to App</a>
            </div>
                    </div>
                </div>
                </div>
            </section>
        </main>
    </div>

    <script src="{{$.Asset "js/i18n-auth.js"}}"></script>
    <script src="{{$.Asset "js/auth.js"}}"></script>
</body>
</html>{{end}}
