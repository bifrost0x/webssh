# Build context of deploy/docker/Dockerfile (repository root). Only the Go
# module with the SMB client fork, the frontend assets, their staging script and the license files
# are sent; everything else, including .git,
# data directories, virtual environments, node_modules and the Python
# application, stays out.
*
!go.mod
!go.sum
!cmd/
!internal/
!static/
!third_party/go-smb2/
!scripts/stage-webassets.sh
!LICENSE
!NOTICE
!THIRD-PARTY-NOTICES

# Tests and their fixtures are not part of the build.
**/*_test.go
**/testdata/
internal/httpapi/webassets/

# Stray files that must never reach an image.
**/.env
**/.env.*
**/*.db
**/*.sqlite*
**/*.pem
**/*.key
**/.DS_Store
**/__pycache__/
