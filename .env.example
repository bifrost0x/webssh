# webssh configuration — copy to .env and adjust.
#
# Real environment variables (Docker, systemd, shell exports) ALWAYS take
# precedence over values in this file, so .env is safe to use alongside them.
# Lines starting with # are comments. Do NOT commit your real .env.

# ─── Security (required in production) ───────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Enable Flask debug mode. NEVER set to True in production.
DEBUG=False

# Compatibility profile. Use production for an Internet-facing deployment;
# unsafe combinations then stop startup instead of only emitting warnings.
DEPLOYMENT_PROFILE=homelab

# ─── Server ──────────────────────────────────────────────────────────────────
# Bind address. Use 0.0.0.0 to accept external connections (e.g. behind a proxy).
HOST=127.0.0.1
PORT=5000

# Directory for the database, keys, logs and per-user data.
DATA_DIR=./data

# URL sub-path when deployed under a sub-folder, e.g. /webssh (leave empty otherwise).
APPLICATION_ROOT=

# ─── Reverse proxy ───────────────────────────────────────────────────────────
# Number of trusted reverse-proxy layers in front of the app (0 = none).
# Set to 1 when behind a single proxy (Traefik, nginx, Caddy) so the real
# client IP is read from X-Forwarded-For.
TRUSTED_PROXIES=0

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins, e.g. https://ssh.example.com
# Leave empty to default to localhost only.
CORS_ORIGINS=
# Allow wildcard CORS (*) in production. Only for trusted networks (homelab).
ALLOW_CORS_WILDCARD=false

# ─── Session / cookies ───────────────────────────────────────────────────────
# Idle SSH session timeout in seconds (default 1800 = 30 min).
SESSION_TIMEOUT=1800
# Force the Secure flag on browser cookies. Set this to true whenever users
# access WebSSH through HTTPS, including TLS terminated at a reverse proxy.
# SESSION_COOKIE_SECURE=

# In-process resource quotas
# All values must be positive integers. SSH, quick-connection and transfer
# per-user limits must remain below their global limits. Quotas are process-
# local and do not remove the mandatory single-worker deployment constraint.
QUOTA_SSH_SESSION_GLOBAL=10
QUOTA_SSH_SESSION_PER_USER=5
QUOTA_QUICK_CONNECTION_GLOBAL=12
QUOTA_QUICK_CONNECTION_PER_USER=3
QUOTA_TRANSFER_GLOBAL=8
QUOTA_TRANSFER_PER_USER=2
QUOTA_TEMP_BYTES_GLOBAL=1073741824
QUOTA_TEMP_BYTES_PER_USER=536870912
QUOTA_BACKGROUND_JOB_GLOBAL=4
QUOTA_BACKGROUND_JOB_PER_USER=1

# Runtime lifecycle workers and graceful process shutdown. When omitted,
# BACKGROUND_WORKERS defaults to the formula below (17 with the defaults
# above). It must remain between that calculated minimum and 128.
# BACKGROUND_WORKERS=17
# Cleanup reserves 3 slots; the minimum is therefore:
# 3 + QUOTA_SSH_SESSION_GLOBAL + QUOTA_BACKGROUND_JOB_GLOBAL.
# The signal gate waits 5 seconds by default; valid values are 1 through 30.
# Docker Compose keeps a 40-second stop grace period for this bounded cleanup.
# RUNTIME_SHUTDOWN_GRACE_SECONDS=5
# One gthread worker remains mandatory. Socket admission preserves HTTP
# capacity: MAX_SOCKET_CONNECTIONS must leave at least four threads unused.
GUNICORN_THREADS=64
MAX_SOCKET_CONNECTIONS=48
MAX_SOCKET_CONNECTIONS_PER_USER=8

# ─── Features ────────────────────────────────────────────────────────────────
# Allow new account registration via the web UI.
# Defaults to false in production and true only in debug mode.
REGISTRATION_ENABLED=False
# A fresh homelab installation can create exactly one administrator through
# the browser, then this bootstrap path closes automatically. Production
# defaults to false and rejects true.
# BOOTSTRAP_REGISTRATION_ENABLED=true
# Disable the Admin Panel entirely (normally enabled).
# ADMIN_PANEL_ENABLED=False
# Existing usernames to promote on startup (comma-separated recovery option).
# ADMIN_USERS=operator
# Optional passkey support. RP ID is the public domain only; origin includes
# scheme and port. Use HTTPS outside localhost.
# WEBAUTHN_ENABLED=true
# WEBAUTHN_RP_ID=ssh.example.com
# WEBAUTHN_RP_NAME=WebSSH
# WEBAUTHN_ORIGIN=https://ssh.example.com
# Maximum JSON body accepted by WebAuthn endpoints (hard ceiling 64 KiB).
MAX_WEBAUTHN_JSON_SIZE=65536
# Host-key management, recovery codes, and audit export are enabled by default.
# Uncomment only to disable a feature.
# HOST_KEY_MANAGEMENT_ENABLED=false
# RECOVERY_CODES_ENABLED=false
# Maximum JSON body accepted by recovery endpoints (default 4 KiB).
MAX_RECOVERY_JSON_SIZE=4096
# AUDIT_EXPORT_ENABLED=false

# Optional OpenID Connect. The client secret must be stored in a separate
# permission-restricted file and mounted read-only when using containers.
# OIDC_ENABLED=true
# OIDC_ISSUER=https://idp.example.com
# OIDC_CLIENT_ID=webssh
# OIDC_CLIENT_SECRET_FILE=/run/secrets/webssh_oidc_client_secret
# OIDC_REDIRECT_URI=https://ssh.example.com/oidc/callback
# OIDC_ALLOWED_SUBJECTS=
# OIDC_ALLOWED_DOMAINS=example.com
# OIDC_LOGIN_RATE_LIMIT=10 per minute
# Block SSH connections to loopback/link-local addresses (SSRF protection).
# Keep false for homelab use where connecting to internal IPs is intended.
BLOCK_INTERNAL_SSH=false
# Exact comma-separated hostnames a ProxyJump bastion may resolve remotely.
# Leave empty unless a trusted bastion-only DNS name cannot be validated locally.
# PROXY_JUMP_REMOTE_DNS_ALLOWLIST=bastion-only.internal

# Allow persistent sessions through tmux installed on the remote SSH host.
TMUX_ENABLED=false
# Preselect persistent tmux sessions in the connection dialog.
TMUX_DEFAULT=false
# Prefix for tmux session names created on remote hosts.
TMUX_SESSION_PREFIX=webssh

# Tailscale SSH uses one shared Tailscale node identity for every authorized
# WebSSH account. It is disabled by default; see docs/tailscale-ssh.md.
TAILSCALE_SSH_ENABLED=false
# Non-admin WebSSH usernames allowed to use the shared identity (comma-separated).
TAILSCALE_SSH_ALLOWED_WEBSSH_USERS=
# Optional exact target host/IP allowlist. Empty means no additional host filter.
TAILSCALE_SSH_ALLOWED_TARGETS=
# Optional exact remote OS username allowlist. Empty means no additional filter.
TAILSCALE_SSH_ALLOWED_REMOTE_USERS=

# ─── Rate limiting ───────────────────────────────────────────────────────────
RATELIMIT_ENABLED=True
RATELIMIT_LOGIN_LIMIT=5 per minute
RATELIMIT_DEFAULT=200 per hour
RATELIMIT_REAUTH=5 per minute
# Per-user SSH and quick-connect attempt rate.
SSH_CONNECT_RATELIMIT=10 per minute
# Storage backend for rate-limit counters.
#   memory://  (default) — per-process, no external dependency.
#   redis://host:port/db — counters survive app restarts while Redis is running.
# Redis does not make multi-worker deployments safe; live SSH state remains
# in-process and the application must continue to run with one worker.
# If Redis is unreachable, requests use an in-memory fallback and the app
# periodically retries Redis without delaying every request.
# RATELIMIT_STORAGE_URL=memory://

# ─── File transfer limits (bytes) ────────────────────────────────────────────
# Max single-file download (default 100 MB).
MAX_DOWNLOAD_SIZE=104857600
# Max folder ZIP download (default 500 MB).
MAX_ZIP_DOWNLOAD_SIZE=524288000
# Maximum number of entries traversed during one folder transfer.
MAX_TRANSFER_MEMBERS=10000
# Maximum bytes read into memory for a file preview.
MAX_PREVIEW_SIZE=512000
# Maximum requested line count for tail-mode previews.
MAX_PREVIEW_TAIL_LINES=10000
# Maximum remote file size accepted by the preview service (1 GiB).
MAX_SUPPORTED_FILE_SIZE=1073741824
# Timeout for one SFTP channel operation in seconds.
SFTP_OPERATION_TIMEOUT=30
# Maximum text file size accepted by the inline editor (5 MiB).
MAX_EDITOR_FILE_SIZE=5242880
# Local disk used only for bounded fallback ZIP creation (default: DATA_DIR/tmp)
# TRANSFER_TEMP_DIR=/var/lib/webssh/tmp

# Rotate each structured application and security audit log at 10 MiB, keeping
# five backups. Both values must be positive integers.
AUDIT_LOG_MAX_BYTES=10485760
AUDIT_LOG_BACKUP_COUNT=5

# Backup verification and restore limits. These are decompressed sizes.
BACKUP_MAX_MEMBERS=10000
BACKUP_MAX_FILE_SIZE=1073741824
BACKUP_MAX_TOTAL_SIZE=10737418240
BACKUP_MAX_COMPRESSION_RATIO=200
BACKUP_MAX_MANIFEST_SIZE=10485760
# Native Admin backup and restore are always available to administrators.
# Operational limits only; BACKUP_TEMP_DIR is a shared base outside DATA_DIR.
BACKUP_UPLOAD_MAX_SIZE=1073741824
BACKUP_OPERATION_TIMEOUT=1800
BACKUP_DOWNLOAD_TTL=600
# BACKUP_TEMP_DIR=/tmp/webssh-backup-operations
RATELIMIT_BACKUP_CREATE=3 per hour
RATELIMIT_BACKUP_UPLOAD=5 per hour
RATELIMIT_BACKUP_DOWNLOAD=10 per hour
RATELIMIT_BACKUP_RESTORE=3 per hour
